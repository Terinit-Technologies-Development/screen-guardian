# =============================================================
# Screen Guardian — Environment Variables Template
# =============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is excluded by .gitignore.
# =============================================================

# --- App Environment ---
APP_ENV=development
# Options: development | staging | production

# --- Backend API ---
# Base URL for the Screen Guardian API / Supabase project
BACKEND_URL=https://your-project.supabase.co

# --- Supabase ---
# Found at: https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is backend-only, never expose in mobile app
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- AI Features ---
# API key for AI provider (OpenAI, Gemini, Anthropic, etc.)
AI_API_KEY=your-ai-api-key-here
AI_PROVIDER=openai
# Options: openai | gemini | anthropic

# --- EAS (Expo Application Services) ---
# Found at: https://expo.dev/accounts/<username>/projects/<slug>
EAS_PROJECT_ID=your-eas-project-id-here

# --- Android Native Config (injected at build time) ---
# How often the background MonitoringService polls usage stats (milliseconds)
ANDROID_MONITORING_INTERVAL_MS=5000
# Package name (must match android/app/build.gradle applicationId)
ANDROID_PACKAGE_NAME=com.screentimeapp
